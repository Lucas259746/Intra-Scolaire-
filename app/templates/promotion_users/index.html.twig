{% extends 'base.html.twig' %}

{% block title %}PromotionUsers index{% endblock %}

{% block body %}
<turbo-frame id="main-frame">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Membres des promotions</h2>
        {% if is_granted('ROLE_ADMIN') %}
            <a href="{{ path('app_promotion_users_new') }}" class="btn btn-success btn-sm">+ Ajouter un membre</a>
        {% endif %}
    </div>

    <div class="responsive-table-wrapper">
        <table class="table table-hover responsive-table">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Etudiant</th>
                    <th>Promotion</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
            {% for promotion_user in promotion_users %}
                <tr>
                    <td data-label="ID">{{ promotion_user.id }}</td>
                    <td data-label="Etudiant">{{ promotion_user.userId.firstname }} {{ promotion_user.userId.lastname }}</td>
                    <td data-label="Promotion">{{ promotion_user.promotionId.name }}</td>
                    <td data-label="Actions">
                        <div class="table-actions">
                            <a href="{{ path('app_promotion_users_show', {'id': promotion_user.id}) }}" class="btn btn-outline-info btn-sm">Voir</a>
                            {% if is_granted('ROLE_ADMIN') %}
                                <a href="{{ path('app_promotion_users_edit', {'id': promotion_user.id}) }}" class="btn btn-outline-warning btn-sm">Modifier</a>
                            {% endif %}
                        </div>
                    </td>
                </tr>
            {% else %}
                <tr class="table-empty-row">
                    <td colspan="4" class="table-empty-state">Aucun etudiant assigne.</td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
    <div class="d-flex justify-content-center mt-3">
        {{ knp_pagination_render(promotion_users) }}
    </div>
</turbo-frame>
{% endblock %}
