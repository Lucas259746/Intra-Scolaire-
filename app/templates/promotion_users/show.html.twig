{% extends 'base.html.twig' %}

{% block title %}Detail membre{% endblock %}

{% block body %}
<turbo-frame id="main-frame">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Detail du membre</h2>
        <a href="{{ path('app_promotion_users_index') }}" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-arrow-left"></i> Retour
        </a>
    </div>

    <div class="detail-table-wrapper">
        <table class="table detail-table">
            <tbody>
                <tr>
                    <th>ID</th>
                    <td>{{ promotion_user.id }}</td>
                </tr>
                <tr>
                    <th>Etudiant</th>
                    <td>{{ promotion_user.user.firstname }} {{ promotion_user.user.lastname }}</td>
                </tr>
                <tr>
                    <th>Promotion</th>
                    <td>{{ promotion_user.promotion.name }}</td>
                </tr>
            </tbody>
        </table>
    </div>

    {% if is_granted('ROLE_ADMIN') %}
        <div class="detail-actions">
            <a href="{{ path('app_promotion_users_edit', {'id': promotion_user.id}) }}" class="btn btn-warning btn-sm">Modifier</a>
            {{ include('promotion_users/_delete_form.html.twig') }}
        </div>
    {% endif %}
</turbo-frame>
{% endblock %}
