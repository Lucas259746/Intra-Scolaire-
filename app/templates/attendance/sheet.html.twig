{% extends 'base.html.twig' %}

{% block body %}
<turbo-frame id="main-frame">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Appel du {{ date|date('d/m/Y') }} : {{ promotion.name }}</h2>

        {# Formulaire de sélection de la date #}
        <form method="get" action="{{ path('app_attendance_sheet', {id: promotion.id}) }}" data-turbo-frame="main-frame">
            <label for="date-select" class="form-label me-2 fw-bold">Historique :</label>
            <select name="date" id="date-select" class="form-select d-inline-block w-auto" onchange="this.form.requestSubmit()">
                {% for key, dateObj in availableDates %}
                    <option value="{{ key }}" {{ date|date('Y-m-d') == key ? 'selected' : '' }}>
                        {{ key == "now"|date('Y-m-d') ? "Aujourd'hui" : dateObj|date('d/m/Y') }}
                    </option>
                {% endfor %}
            </select>
        </form>
    </div>

    <div class="mb-4">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h3>Signatures en attente</h3>
            {% if isToday %}
                <form action="{{ path('app_attendance_signatures_reset', {id: promotion.id}) }}" method="post" class="d-inline-block">
                    <input type="hidden" name="_token" value="{{ csrf_token('reset_signatures' ~ promotion.id) }}">
                    <button type="submit" class="btn btn-warning btn-sm" onclick="return confirm('Êtes-vous sûr de vouloir réinitialiser les signatures ? Les étudiants pourront de nouveau signer leur présence.');">
                        <i class="bi bi-arrow-clockwise"></i> Réinitialiser les signatures
                    </button>
                </form>
            {% endif %}
        </div>
        <div class="table-responsive">
         <table class="table table-bordered">
            <thead>
                <tr>
                    <th>Étudiant</th>
                    <th>Demande</th>
                    <th>Heure</th>
                    <th>Commentaire</th>
                    <th>Justificatif</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                {% if pendingSignatures is empty %}
                    <tr>
                        <td colspan="6" class="text-center text-muted">Aucune signature en attente pour cette date.</td>
                    </tr>
                {% else %}
                    {% for signature in pendingSignatures %}
                        <tr>
                            {# 1. Étudiant #}
                            <td>{{ signature.student.firstname|capitalize }} {{ signature.student.lastname|upper }}</td>
                            
                            {# 2. Demande #}
                            <td>
                                {% if signature.status.value == 'pending_present' %}
                                    Présent demandé
                                {% elseif signature.status.value == 'pending_late' %}
                                    Retard demandé
                                {% else %}
                                    Absent demandé
                                {% endif %}
                            </td>
                            
                            {# 3. Heure #}
                            <td>{{ signature.signedAt ? signature.signedAt|date('d/m/Y H:i') : '-' }}</td>
                            
                            {# 4. Commentaire #}
                            <td>{{ signature.comment ?: '-' }}</td>
                            
                            {# 5. Justificatif #}
                            <td>
                                {% if signature.document is defined and signature.document is not null %}
                                    
                                    <span class="badge bg-success"><i class="bi bi-file-earmark-check"></i> {{ signature.document.title }}</span>
                                {% else %}
                                    <span class="text-muted">-</span>
                                {% endif %}
                            </td>
                            
                            {# 6. Actions #}
                            <td>
                                <form action="{{ path('app_attendance_signature_validate', {id: signature.id}) }}" method="post" class="d-inline-block">
                                    <input type="hidden" name="status" value="present">
                                    <input type="hidden" name="_token" value="{{ csrf_token('validate_signature' ~ signature.id) }}">
                                    <button type="submit" class="btn btn-sm btn-success me-1">Présent</button>
                                </form>
                                <form action="{{ path('app_attendance_signature_validate', {id: signature.id}) }}" method="post" class="d-inline-block">
                                    <input type="hidden" name="status" value="late">
                                    <input type="hidden" name="_token" value="{{ csrf_token('validate_signature' ~ signature.id) }}">
                                    <button type="submit" class="btn btn-sm btn-warning me-1">Retard</button>
                                </form>
                                <form action="{{ path('app_attendance_signature_validate', {id: signature.id}) }}" method="post" class="d-inline-block">
                                    <input type="hidden" name="status" value="absent">
                                    <input type="hidden" name="_token" value="{{ csrf_token('validate_signature' ~ signature.id) }}">
                                    <button type="submit" class="btn btn-sm btn-danger">Absent</button>
                                </form>
                            </td>
                        </tr>
                    {% endfor %}
                {% endif %}
            </tbody>
        </table>
        </div>
    </div>

    {# Formulaire principal / Tableau de lecture de l'historique #}
    <form action="{{ path('app_attendance_sheet', {id: promotion.id}) }}" method="post">
        <div class="table-responsive">
            <table class="table table-bordered table-striped align-middle">
                <thead>
                    <tr>
                        <th>Étudiant</th>
                        {% if isToday %}
                            <th>Présent</th>
                            <th>En retard</th>
                            <th>Absent</th>
                        {% else %}
                            <th>Statut Validé</th>
                            <th>Heure d'émargement</th>
                            <th>Commentaire / Motif</th>
                        {% endif %}
                    </tr>
                </thead>        
                <tbody>
                    {% for student in students %}
                        {% set existingAttendance = attendanceMap[student.id] ?? null %}
                        {% set currentStatus = existingAttendance ? existingAttendance.status.value : 'present' %}
                        {% set radioStatus = currentStatus %}
                        {% if currentStatus == 'pending_present' %}
                            {% set radioStatus = 'present' %}
                        {% elseif currentStatus == 'pending_absent' %}
                            {% set radioStatus = 'absent' %}
                        {% elseif currentStatus == 'pending_late' %}
                            {% set radioStatus = 'late' %}
                        {% endif %}
                        
                        <tr>
                            <td>
                                <strong>{{ student.firstname|capitalize }} {{ student.lastname|upper }}</strong>
                                {% if isToday and existingAttendance %}
                                    {% if existingAttendance.status.value == 'pending_present' %}
                                        <span class="badge bg-warning text-dark ms-2">Demande élève : présent</span>                  
                                    {% elseif existingAttendance.status.value == 'pending_late' %}
                                        <span class="badge bg-warning text-dark ms-2">Demande élève : retard</span>                            
                                    {% elseif existingAttendance.status.value == 'pending_absent' %}
                                        <span class="badge bg-warning text-dark ms-2">Demande élève : absent</span>
                                    {% endif %}
                                {% endif %}
                            </td>
                     
                            {% if isToday %}
                                {# Mode d'appel actif (Aujourd'hui) #}
                                <td>
                                    <input type="radio" name="attendance[{{ student.id }}]" value="present" 
                                           {{ radioStatus == 'present' ? 'checked' : '' }}>
                                </td>
                                <td>
                                    <input type="radio" name="attendance[{{ student.id }}]" value="late" 
                                           {{ radioStatus == 'late' ? 'checked' : '' }}>
                                </td>
                                <td>
                                    <input type="radio" name="attendance[{{ student.id }}]" value="absent" 
                                           {{ radioStatus == 'absent' ? 'checked' : '' }}>
                                </td>
                            {% else %}
                                {# Mode consultation historique (Jours précédents) #}
                                <td>
                                    {% if existingAttendance %}
                                        {% if existingAttendance.status.value == 'present' %}
                                            <span class="badge bg-success"><i class="bi bi-check-circle-fill"></i> Présent</span>
                                        {% elseif existingAttendance.status.value == 'late' %}
                                            <span class="badge bg-warning text-dark"><i class="bi bi-clock-fill"></i> En retard</span>
                                        {% elseif existingAttendance.status.value == 'absent' %}
                                            <span class="badge bg-danger"><i class="bi bi-x-circle-fill"></i> Absent</span>
                                        {% else %}
                                            <span class="badge bg-secondary">{{ existingAttendance.status.value }}</span>
                                        {% endif %}
                                    {% else %}
                                        <span class="badge bg-light text-muted">Non marqué</span>
                                    {% endif %}
                                </td>
                                <td>
                                    {{ (existingAttendance and existingAttendance.signedAt) ? existingAttendance.signedAt|date('d/m/Y H:i') : '-' }}
                                </td>
                                <td>
                                    <span class="text-muted">{{ (existingAttendance and existingAttendance.comment) ? existingAttendance.comment : '-' }}</span>
                                </td>
                            {% endif %}
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
        
        <div class="mt-3">
            {% if isToday %}
                <button type="submit" class="btn btn-primary">Valider l'appel</button>
            {% else %}
                <div class="alert alert-info d-inline-block py-2 px-3 mb-0 me-2">
                    <i class="bi bi-lock-fill"></i> Consultation (Historique verrouillé)
                </div>
            {% endif %}
            <a href="{{ path('app_attendance') }}" class="btn btn-secondary">Retour</a>
        </div>
    </form>
</turbo-frame>
{% endblock %}