<form method="post" action="{{ path('app_absences_delete', {'id': absence.id}) }}" onsubmit="return confirm('Confirmer la suppression de cette absence ?');">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ absence.id) }}">
    <button class="btn btn-danger btn-sm mt-2"><i class="bi bi-trash"></i> Supprimer</button>
</form>
