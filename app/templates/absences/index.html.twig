{% extends 'base.html.twig' %}

{% block title %}Absences{% endblock %}

{% block body %}
<turbo-frame id="main-frame">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Absences</h2>
        {% if is_granted('ROLE_TEACHER') %}
            <a href="{{ path('app_absences_new') }}" class="btn btn-success btn-sm">+ Nouvelle absence</a>
        {% endif %}
    </div>

    <table class="table table-hover">
        <thead>
            <tr>
                <th>Étudiant</th>
                <th>Début</th>
                <th>Fin</th>
                <th>Justificatif</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
        {% for absence in absences %}
            <tr>
                <td>{{ absence.user.firstname }} {{ absence.user.lastname }}</td>
                <td>{{ absence.startDate ? absence.startDate|date('d/m/Y H:i') : '—' }}</td>
                <td>{{ absence.endDate ? absence.endDate|date('d/m/Y H:i') : '—' }}</td>
                <td>
                    {% if absence.document %}
                        <span class="badge bg-success"><i class="bi bi-file-earmark-check"></i> {{ absence.document.title }}</span>
                    {% else %}
                        <span class="text-muted">—</span>
                    {% endif %}
                </td>
                <td>
                    <a href="{{ path('app_absences_show', {'id': absence.id}) }}" class="btn btn-outline-info btn-sm">Voir</a>
                    {% if is_granted('ROLE_TEACHER') %}
                        <a href="{{ path('app_absences_edit', {'id': absence.id}) }}" class="btn btn-outline-warning btn-sm">Modifier</a>
                    {% endif %}
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="5" class="text-center text-muted py-4">Aucune absence enregistrée.</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
    <div class="d-flex justify-content-center mt-3">
        {{ knp_pagination_render(absences) }}
    </div>
</turbo-frame>
{% endblock %}
