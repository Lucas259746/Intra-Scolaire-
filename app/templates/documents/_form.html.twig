{{ form_start(form, {'action': app.request.requestUri, 'attr': {'class': 'dashboard-form'}}) }}
    <div class="dashboard-form-shell">
        <div class="dashboard-form-intro">
            <span class="pill">Document</span>
            <p class="dashboard-note">Renseigne le contenu et ajoute le fichier pour le rendre accessible rapidement.</p>
        </div>

        {% if form_errors(form) %}
            <div class="dashboard-flash dashboard-flash-danger">
                {{ form_errors(form) }}
            </div>
        {% endif %}

        <div class="dashboard-form-fields">
            {{ form_widget(form) }}
        </div>

        <div class="dashboard-form-actions">
            <button class="btn btn-primary">{{ button_label|default('Enregistrer le document') }}</button>
        </div>
    </div>
{{ form_end(form) }}
