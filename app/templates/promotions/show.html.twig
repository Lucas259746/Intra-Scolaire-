{% extends 'base.html.twig' %}

{% block title %}Detail promotion{% endblock %}

{% block body %}
<turbo-frame id="main-frame">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Detail de la promotion</h2>
        <a href="{{ path('app_promotions_index') }}" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-arrow-left"></i> Retour
        </a>
    </div>

    <div class="detail-table-wrapper">
        <table class="table detail-table">
            <tbody>
                <tr>
                    <th>ID</th>
                    <td>{{ promotion.id }}</td>
                </tr>
                <tr>
                    <th>Nom</th>
                    <td>{{ promotion.name }}</td>
                </tr>
                <tr>
                    <th>Projets</th>
                    <td>
                        <ul>
                        {% for project in promotion.projects %}
                            <li>
                                <a href="{{ path('app_projects_show', {'id': project.id}) }}">
                                    {{ project.title }}
                                </a>
                            </li>
                        {% else %}
                            <li>Aucun projet</li>
                        {% endfor %}
                        </ul>
                    </td>
                </tr>
            </tbody>
        </table>
    </div>

    {% if is_granted('ROLE_TEACHER') %}
        <div class="detail-actions">
            <a href="{{ path('app_promotions_edit', {'id': promotion.id}) }}" class="btn btn-warning btn-sm">Modifier</a>
            {{ include('promotions/_delete_form.html.twig') }}
        </div>
    {% endif %}
</turbo-frame>
{% endblock %}
