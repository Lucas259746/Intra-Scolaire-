{{ form_start(form, {'action': form_action}) }}
    <div class="dashboard-form-shell">
        <div class="dashboard-form-intro">
            <span class="pill">Notification</span>
            <p class="dashboard-note">Prepare un message clair et cible le bon public avant envoi.</p>
        </div>

        {% if form_errors(form) %}
            <div class="dashboard-flash dashboard-flash-danger">
                {{ form_errors(form) }}
            </div>
        {% endif %}

        <div class="dashboard-form-fields">
            <div>
                {{ form_label(form.title) }}
                {{ form_widget(form.title) }}
                {{ form_errors(form.title) }}
            </div>
            <div>
                {{ form_label(form.message) }}
                {{ form_widget(form.message) }}
                {{ form_errors(form.message) }}
            </div>
            <div>
                {{ form_label(form.type) }}
                {{ form_widget(form.type) }}
                {{ form_errors(form.type) }}
            </div>
            <div>
                {{ form_label(form.audience) }}
                {{ form_widget(form.audience, {'attr': {'id': 'audience-select'}}) }}
                {{ form_errors(form.audience) }}
            </div>
            <div>
                {{ form_label(form.promotion) }}
                {{ form_widget(form.promotion) }}
                {{ form_errors(form.promotion) }}
            </div>
        </div>

        <div class="dashboard-form-actions">
            <button class="btn btn-primary">{{ button_label|default('Envoyer la notification') }}</button>
        </div>
    </div>
{{ form_end(form) }}
