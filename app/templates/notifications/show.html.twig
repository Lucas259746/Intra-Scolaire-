{% extends 'base.html.twig' %}

{% block title %}Detail notification{% endblock %}

{% block body %}
<turbo-frame id="main-frame">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Detail de la notification</h2>
        <a href="{{ path('app_notifications_index') }}" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-arrow-left"></i> Retour
        </a>
    </div>

    {% set type = notification.type.value %}

    <div class="detail-table-wrapper">
        <table class="table detail-table">
            <tbody>
                <tr>
                    <th>ID</th>
                    <td>#{{ notification.id }}</td>
                </tr>
                <tr>
                    <th>Titre</th>
                    <td>{{ notification.title }}</td>
                </tr>
                <tr>
                    <th>Message</th>
                    <td>{{ notification.message }}</td>
                </tr>
                <tr>
                    <th>Type</th>
                    <td>
                        {% if type == 'alert' %}
                            <span class="badge bg-primary">Alerte</span>
                        {% elseif type == 'warning' %}
                            <span class="badge bg-warning">Avertissement</span>
                        {% elseif type == 'error' %}
                            <span class="badge bg-danger">Erreur</span>
                        {% elseif type == 'success' %}
                            <span class="badge bg-success">Succes</span>
                        {% else %}
                            <span class="badge bg-secondary">{{ type }}</span>
                        {% endif %}
                    </td>
                </tr>
            </tbody>
        </table>
    </div>

    {% if is_granted('ROLE_TEACHER') %}
        <div class="detail-actions">
            <a href="{{ path('app_notifications_edit', {'id': notification.id}) }}" class="btn btn-warning btn-sm">
                <i class="bi bi-pencil"></i> Modifier
            </a>
            {{ include('notifications/_delete_form.html.twig') }}
        </div>
    {% endif %}
</turbo-frame>
{% endblock %}
